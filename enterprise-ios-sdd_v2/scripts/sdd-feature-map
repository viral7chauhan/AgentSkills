#!/usr/bin/env python3
"""Generate .sdd/feature-map.md — architecture + feature relationship diagrams.

Reads hand-maintained `.sdd/feature-map.yaml` (layers, feature relations) and
enriches rows with live status from each feature's `status.yaml`.
"""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

MAP_YAML = Path('.sdd/feature-map.yaml')
MAP_MD = Path('.sdd/feature-map.md')
ARCHITECTURE = Path('.sdd/project/architecture.md')
FEATURES = Path('.sdd/features')
START = '<!-- sdd-feature-map:start -->'
END = '<!-- sdd-feature-map:end -->'


def read(path: Path) -> str:
    return path.read_text() if path.exists() else ''


def field(text: str, name: str) -> str:
    m = re.search(rf'^{re.escape(name)}:\s*(.*)$', text, re.M)
    return m.group(1).strip().strip('"').strip("'") if m else ''


def mermaid_id(value: str) -> str:
    return re.sub(r'[^A-Za-z0-9_]', '_', value)


def parse_simple_yaml(text: str) -> dict:
    """Minimal YAML subset parser for layers/features maps used here."""
    data: dict = {'layers': [], 'features': []}
    section = None
    current: dict | None = None
    list_key = None

    for raw in text.splitlines():
        if not raw.strip() or raw.lstrip().startswith('#'):
            continue
        # top-level keys
        if re.match(r'^layers:\s*$', raw):
            section = 'layers'
            current = None
            list_key = None
            continue
        if re.match(r'^features:\s*(\[\])?\s*$', raw):
            section = 'features'
            current = None
            list_key = None
            continue
        if section is None:
            continue

        # new list item
        item = re.match(r'^  - (\w+):\s*(.*)$', raw)
        if item:
            current = {item.group(1): _scalar(item.group(2))}
            data[section].append(current)
            list_key = None
            continue

        if current is None:
            continue

        # nested list start: key: or key: []
        nested = re.match(r'^    (\w+):\s*(\[\])?\s*$', raw)
        if nested and nested.group(2) is not None:
            current[nested.group(1)] = []
            list_key = nested.group(1)
            continue
        if nested and nested.group(2) is None:
            # Could be start of list without [] — peek next; treat as empty list key
            current[nested.group(1)] = []
            list_key = nested.group(1)
            continue

        # nested scalar
        scalar = re.match(r'^    (\w+):\s*(.+)$', raw)
        if scalar:
            current[scalar.group(1)] = _scalar(scalar.group(2))
            list_key = None
            continue

        # list entry under nested key
        entry = re.match(r'^      - (.+)$', raw)
        if entry and list_key:
            current.setdefault(list_key, []).append(_scalar(entry.group(1)))
            continue

    return data


def _scalar(value: str):
    value = value.strip()
    if value in ('[]', ''):
        return []
    if value.startswith('[') and value.endswith(']'):
        inner = value[1:-1].strip()
        if not inner:
            return []
        return [_scalar(p) for p in inner.split(',')]
    if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
        return value[1:-1]
    return value


def status_for(feature_id: str, folder: str | None) -> dict:
    root = None
    if folder:
        candidate = FEATURES / folder
        if candidate.exists():
            root = candidate
    if root is None and FEATURES.exists():
        matches = list(FEATURES.glob(f'{feature_id}-*'))
        root = matches[0] if matches else None
    if root is None:
        return {'status': 'MISSING', 'folder': folder or ''}
    status = read(root / 'status.yaml')
    return {
        'status': (field(status, 'status') or 'UNKNOWN').upper(),
        'folder': root.name,
        'req': f"{field(status, 'requirements_verified') or '0'}/{field(status, 'requirements_total') or '0'}",
        'plan': f"{field(status, 'plan_items_verified') or '0'}/{field(status, 'plan_items_total') or '0'}",
    }


def architecture_snippet() -> str:
    text = read(ARCHITECTURE)
    if not text.strip():
        return '_No `.sdd/project/architecture.md` yet._\n'
    # Flatten nested markdown fences so the generated doc stays valid.
    cleaned = []
    in_fence = False
    for ln in text.splitlines():
        if ln.strip().startswith('```'):
            in_fence = not in_fence
            cleaned.append('')  # keep spacing without nested fences
            continue
        cleaned.append(ln)
    lines = [ln for ln in cleaned if ln.strip()][:40]
    return '```text\n' + '\n'.join(lines) + '\n```\n'


def enrich(data: dict) -> tuple[list, list]:
    layers = data.get('layers') or []
    features = data.get('features') or []
    enriched = []
    for f in features:
        fid = str(f.get('id', ''))
        live = status_for(fid, f.get('folder'))
        row = dict(f)
        row['live_status'] = live['status']
        row['folder'] = live['folder'] or f.get('folder', '')
        row['req'] = live.get('req', '0/0')
        row['plan'] = live.get('plan', '0/0')
        for key in ('depends_on', 'related_to', 'shares_modules_with', 'modules', 'provides', 'consumes'):
            val = row.get(key, [])
            if not isinstance(val, list):
                row[key] = [val] if val else []
        enriched.append(row)
    return layers, enriched


def render(data: dict, *, link_prefix: str = 'features/', include_architecture: bool = True, guide: bool = True) -> str:
    layers, enriched = enrich(data)
    lines = []

    if include_architecture:
        lines += [
            '### Architecture (from project)',
            '',
            architecture_snippet().rstrip(),
            '',
        ]

    lines += ['### Layer map', '']

    if layers:
        lines += ['```mermaid', 'flowchart TB']
        for layer in layers:
            lid = mermaid_id(str(layer.get('id', layer.get('name', 'layer'))))
            label = f"{layer.get('name', lid)}\\n{layer.get('path', '')}"
            lines.append(f'  {lid}["{label}"]')
        for i in range(len(layers) - 1):
            a = mermaid_id(str(layers[i].get('id', layers[i].get('name'))))
            b = mermaid_id(str(layers[i + 1].get('id', layers[i + 1].get('name'))))
            lines.append(f'  {a} --> {b}')
        for f in enriched:
            fid = mermaid_id(str(f.get('id', 'FTR')))
            layer = mermaid_id(str(f.get('primary_layer', 'domain')))
            name = str(f.get('name', f.get('id')))
            status = f.get('live_status', '?')
            lines.append(f'  {fid}["{f.get("id")}\\n{name}\\n({status})"]')
            lines.append(f'  {layer} --- {fid}')
        lines += ['```', '']
    else:
        lines += ['_No layers defined in `feature-map.yaml`._', '']

    lines += ['### Feature dependency graph', '']
    if enriched:
        lines += ['```mermaid', 'flowchart LR']
        for f in enriched:
            fid = mermaid_id(str(f.get('id')))
            lines.append(f'  {fid}["{f.get("id")}\\n{f.get("name")}\\n{f.get("live_status")}"]')
        for f in enriched:
            fid = mermaid_id(str(f.get('id')))
            for dep in f.get('depends_on') or []:
                lines.append(f'  {mermaid_id(str(dep))} -->|depends on| {fid}')
            for rel in f.get('related_to') or []:
                lines.append(f'  {fid} -. related .- {mermaid_id(str(rel))}')
            for share in f.get('shares_modules_with') or []:
                lines.append(f'  {fid} -. shares modules .- {mermaid_id(str(share))}')
        providers = {}
        for f in enriched:
            for cap in f.get('provides') or []:
                providers.setdefault(str(cap), []).append(str(f.get('id')))
        for f in enriched:
            for cap in f.get('consumes') or []:
                for provider in providers.get(str(cap), []):
                    lines.append(
                        f'  {mermaid_id(provider)} -->|provides {cap}| {mermaid_id(str(f.get("id")))}'
                    )
        lines += ['```', '']
    else:
        lines += [
            '_No features listed in `feature-map.yaml` yet._',
            '',
            'Add an entry when you create a feature, then re-run `make feature-map`.',
            '',
        ]

    lines += [
        '### Feature correlation table',
        '',
        '| Feature | Status | Primary layer | Modules | Depends on | Related to | Provides | Consumes | Progress |',
        '| --- | --- | --- | --- | --- | --- | --- | --- | --- |',
    ]
    if not enriched:
        lines.append('| — | — | — | — | — | — | — | — | — |')
    else:
        for f in enriched:
            link = f"[{f.get('id')}]({link_prefix}{f.get('folder')}/spec.md)" if f.get('folder') else f.get('id')
            lines.append(
                f"| {link} {f.get('name', '')} "
                f"| `{f.get('live_status')}` "
                f"| `{f.get('primary_layer', '')}` "
                f"| {', '.join(f'`{m}`' for m in (f.get('modules') or [])) or '—'} "
                f"| {', '.join(f.get('depends_on') or []) or '—'} "
                f"| {', '.join(f.get('related_to') or []) or '—'} "
                f"| {', '.join(f.get('provides') or []) or '—'} "
                f"| {', '.join(f.get('consumes') or []) or '—'} "
                f"| req {f.get('req')}; plan {f.get('plan')} |"
            )

    if guide:
        lines += [
            '',
            '### How to maintain this',
            '',
            '1. Edit `.sdd/feature-map.yaml` when a feature is created or its relationships change.',
            '2. Record hard prerequisites in `depends_on`, soft links in `related_to`, shared code in `shares_modules_with`.',
            '3. Use `provides` / `consumes` for capability contracts between features.',
            '4. Run `make feature-map` (and commit the regenerated `.sdd/feature-map.md`).',
            '',
        ]
    else:
        lines.append('')
    return '\n'.join(lines)


def with_body(doc: str, body: str) -> str:
    start, end = doc.find(START), doc.find(END)
    if start == -1 or end == -1 or end < start:
        raise ValueError(f'document needs {START} and {END} markers')
    return doc[: start + len(START)] + '\n\n' + body.rstrip() + '\n\n' + doc[end:]


def write_map(body: str) -> None:
    current = read(MAP_MD) if MAP_MD.exists() else (
        '# Project Feature Map\n\n'
        '> Generated by `scripts/sdd-feature-map` from `.sdd/feature-map.yaml`.\n\n'
        f'{START}\n\n_No features yet._\n\n{END}\n'
    )
    try:
        expected = with_body(current, body)
    except ValueError:
        expected = (
            '# Project Feature Map\n\n'
            '> Generated by `scripts/sdd-feature-map` from `.sdd/feature-map.yaml`.\n\n'
            f'{START}\n\n{body.rstrip()}\n\n{END}\n'
        )
    MAP_MD.parent.mkdir(parents=True, exist_ok=True)
    if not MAP_MD.exists() or read(MAP_MD) != expected:
        MAP_MD.write_text(expected)
        print(f'Updated {MAP_MD}')
    else:
        print(f'{MAP_MD} is already current')


def main() -> int:
    ap = argparse.ArgumentParser(description='Generate .sdd/feature-map.md from feature-map.yaml.')
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument('--check', action='store_true', help='fail if feature-map.md is stale')
    mode.add_argument('--stdout', action='store_true', help='print without writing')
    mode.add_argument('--update-readme', metavar='PATH', help='rewrite the feature-map section inside PATH')
    mode.add_argument('--check-readme', metavar='PATH', help='fail if the feature-map section inside PATH is stale')
    args = ap.parse_args()

    if not MAP_YAML.exists():
        print(f'{MAP_YAML} missing. Bootstrap the project or copy templates/project/feature-map.yaml.', file=sys.stderr)
        return 2

    data = parse_simple_yaml(read(MAP_YAML))
    body = render(data)

    if args.stdout:
        print(body)
        return 0

    readme_path = args.update_readme or args.check_readme
    if readme_path:
        path = Path(readme_path)
        readme_body = render(
            data,
            link_prefix='.sdd/features/',
            include_architecture=False,
            guide=False,
        )
        current = read(path)
        try:
            expected = with_body(current, readme_body)
        except ValueError as error:
            print(f'{path}: {error}', file=sys.stderr)
            return 2
        if args.update_readme:
            if expected != current:
                path.write_text(expected)
                print(f'Updated feature-map section in {path}')
            else:
                print(f'Feature-map section in {path} is already current')
            write_map(body)
            return 0
        if expected != current:
            print(f'{path}: feature-map section is out of date. Run `make readme` and commit the result.', file=sys.stderr)
            return 1
        print(f'Feature-map section in {path} matches feature-map.yaml and status')
        return 0

    try:
        expected = with_body(
            read(MAP_MD) if MAP_MD.exists() else f'# Project Feature Map\n\n{START}\n\n_\n\n{END}\n',
            body,
        )
    except ValueError:
        expected = (
            '# Project Feature Map\n\n'
            '> Generated by `scripts/sdd-feature-map` from `.sdd/feature-map.yaml`.\n\n'
            f'{START}\n\n{body.rstrip()}\n\n{END}\n'
        )

    if args.check:
        if not MAP_MD.exists() or read(MAP_MD) != expected:
            print(f'{MAP_MD}: out of date. Run `make feature-map` and commit the result.', file=sys.stderr)
            return 1
        print(f'{MAP_MD} matches feature-map.yaml and feature status')
        return 0

    write_map(body)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
