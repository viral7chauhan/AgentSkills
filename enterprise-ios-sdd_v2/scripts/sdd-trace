#!/usr/bin/env python3
from pathlib import Path
import re
import sys

FEATURE_ROOT = Path('.sdd/features')


def ids(text, prefix):
    return sorted(set(re.findall(rf'\b{re.escape(prefix)}-[A-Za-z0-9-]+\b', text)))


def main():
    if not FEATURE_ROOT.exists():
        print('No .sdd/features directory found')
        return 0
    failures = 0
    for root in sorted(FEATURE_ROOT.glob('FTR-*')):
        combined = ''
        for name in ['spec.md','plan.md','tasks.md','test-plan.md']:
            p = root / name
            if p.exists(): combined += '\n' + p.read_text()
        fr = ids((root/'spec.md').read_text() if (root/'spec.md').exists() else '', 'FR')
        ac = ids((root/'spec.md').read_text() if (root/'spec.md').exists() else '', 'AC')
        plans = ids((root/'plan.md').read_text() if (root/'plan.md').exists() else '', 'P')
        tests = ids((root/'test-plan.md').read_text() if (root/'test-plan.md').exists() else '', 'TC')
        if fr and not ac:
            print(f'BLOCKED {root.name}: requirements exist without acceptance criteria')
            failures += 1
        if plans and not tests:
            print(f'WARNING {root.name}: plan items exist without test cases')
        print(f'{root.name}: FR={len(fr)} AC={len(ac)} P={len(plans)} TC={len(tests)}')
    return 1 if failures else 0


if __name__ == '__main__':
    raise SystemExit(main())
