#!/usr/bin/env python3
import argparse
import re
import sys
from pathlib import Path

FEATURES = Path('.sdd/features')
TRACE = Path('.sdd/traceability.yaml')

REQ = r'\bN?FR-[A-Za-z0-9-]*[A-Za-z0-9]'
AC = r'\bAC-[A-Za-z0-9-]*[A-Za-z0-9]'
PLAN = r'\bP-[A-Za-z0-9-]*[A-Za-z0-9]'

COUNT_KEYS = [
    'requirements_total', 'requirements_implemented', 'requirements_verified',
    'plan_items_total', 'plan_items_verified',
    'tasks_total', 'tasks_verified',
    'test_cases_total', 'test_cases_passing',
]

TRACE_HEADER = (
    '# Generated by scripts/sdd-status from .sdd/features. Edit the feature files and run `make status`.\n'
    '# Only ci_runs and prs are maintained by hand.\n'
)


def read(path: Path) -> str:
    return path.read_text() if path.exists() else ''


def ordered(items):
    seen = []
    for item in items:
        if item not in seen:
            seen.append(item)
    return seen


def find(pattern, text):
    return ordered(re.findall(pattern, text))


def table(text: str, first_header: str):
    """Rows of the first Markdown table whose header starts with first_header, keyed by header name."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        cells = [c.strip() for c in line.strip().strip('|').split('|')]
        if line.strip().startswith('|') and cells and cells[0] == first_header:
            rows = []
            for row in lines[i + 2:]:
                if not row.strip().startswith('|'):
                    break
                values = [c.strip() for c in row.strip().strip('|').split('|')]
                rows.append(dict(zip(cells, values)))
            return rows
    return []


def plan_items(plan: str):
    items = {}
    for block in re.split(r'^###\s+', plan, flags=re.M)[1:]:
        heading = re.match(PLAN, block)
        if not heading:
            continue
        line = re.search(r'^-\s*Requirements:\s*(.*)$', block, re.M)
        items[heading.group(0)] = find(REQ, line.group(1)) if line else []
    return items


def execution_states(execution: str):
    states = {}
    current = None
    for line in execution.splitlines():
        item = re.match(r'^\s*-\s*id:\s*(P-\S+)\s*$', line)
        if item:
            current = item.group(1)
            continue
        state = re.match(r'^\s{4}status:\s*(\S+)', line)
        if current and state:
            states[current] = state.group(1)
            current = None
    return states


def analyze(root: Path):
    feature = '-'.join(root.name.split('-')[:2])
    spec = read(root/'spec.md')
    plan = plan_items(read(root/'plan.md'))
    states = execution_states(read(root/'execution.yaml'))
    tasks = table(read(root/'tasks.md'), 'Task ID')
    tests = table(read(root/'test-plan.md'), 'Test ID')

    reqs = find(REQ, spec)
    acs = find(AC, spec)

    pairs = []
    for row in tests:
        rr, aa = find(REQ, row.get('Requirement', '')), find(AC, row.get('Acceptance', ''))
        if len(rr) == len(aa):
            pairs += list(zip(rr, aa))
        else:
            # Non-functional requirements carry no acceptance criteria in spec.md.
            pairs += [(r, a) for r in rr if not r.startswith('NFR') for a in aa]

    def plans_for(req):
        return [p for p, rs in plan.items() if req in rs]

    def tasks_for(pids):
        return [t['Task ID'] for t in tasks if t.get('Plan Item') in pids]

    def tests_with(pattern_id, column):
        return [t['Test ID'] for t in tests if pattern_id in find(REQ if column == 'Requirement' else AC, t.get(column, ''))]

    requirements = []
    for r in reqs:
        pids = plans_for(r)
        requirements.append({
            'id': r, 'feature': feature,
            'acceptance': ordered(a for rr, a in pairs if rr == r),
            'plan_items': pids,
            'tasks': tasks_for(pids),
            'tests': tests_with(r, 'Requirement'),
        })

    acceptance = [{
        'id': a, 'feature': feature,
        'requirements': ordered(r for r, aa in pairs if aa == a),
        'tests': tests_with(a, 'Acceptance'),
    } for a in acs]

    plans = [{
        'id': p, 'feature': feature,
        'requirements': rs,
        'tasks': tasks_for([p]),
        'status': states.get(p, 'MISSING'),
    } for p, rs in plan.items()]

    task_rows = [{
        'id': t['Task ID'], 'feature': feature,
        'plan_item': t.get('Plan Item', ''),
        'state': t.get('State', ''),
    } for t in tasks]

    test_rows = [{
        'id': t['Test ID'], 'feature': feature,
        'requirements': find(REQ, t.get('Requirement', '')),
        'acceptance': find(AC, t.get('Acceptance', '')),
        'status': t.get('Status', ''),
    } for t in tests]

    def done(req, allowed):
        pids = plans_for(req)
        return bool(pids) and all(states.get(p) in allowed for p in pids)

    counts = {
        'requirements_total': len(reqs),
        'requirements_implemented': sum(done(r, {'IMPLEMENTED', 'VERIFIED'}) for r in reqs),
        'requirements_verified': sum(done(r, {'VERIFIED'}) for r in reqs),
        'plan_items_total': len(plan),
        'plan_items_verified': sum(states.get(p) == 'VERIFIED' for p in plan),
        'tasks_total': len(tasks),
        'tasks_verified': sum(t.get('State') == 'VERIFIED' for t in tasks),
        'test_cases_total': len(tests),
        'test_cases_passing': sum(t.get('Status', '').lower() == 'pass' for t in tests),
    }
    return counts, {
        'requirements': requirements, 'acceptance_criteria': acceptance,
        'plan_items': plans, 'tasks': task_rows, 'tests': test_rows,
    }


def status_text(current: str, counts) -> str:
    text = current
    for key in COUNT_KEYS:
        line = f'{key}: {counts[key]}'
        pattern = re.compile(rf'^{key}:.*$', re.M)
        text = pattern.sub(line, text) if pattern.search(text) else text.rstrip('\n') + '\n' + line + '\n'
    return text


def yaml_value(value):
    if isinstance(value, list):
        return '[' + ', '.join(value) + ']'
    return str(value)


def trace_text(current: str, sections) -> str:
    out = [TRACE_HEADER]
    for name in ['requirements', 'acceptance_criteria', 'plan_items', 'tasks', 'tests']:
        rows = sections[name]
        if not rows:
            out.append(f'{name}: []\n')
            continue
        out.append(f'{name}:\n')
        for row in rows:
            keys = list(row)
            out.append(f'  - {keys[0]}: {yaml_value(row[keys[0]])}\n')
            for key in keys[1:]:
                out.append(f'    {key}: {yaml_value(row[key])}\n')
    kept = re.search(r'^ci_runs:.*', current, re.M | re.S)
    out.append(kept.group(0).rstrip('\n') + '\n' if kept else 'ci_runs: []\nprs: []\n')
    return ''.join(out)


def main():
    ap = argparse.ArgumentParser(description='Derive status.yaml counts and traceability.yaml from feature artifacts.')
    ap.add_argument('--check', action='store_true', help='fail if a derived file is stale instead of rewriting it')
    args = ap.parse_args()

    roots = sorted(FEATURES.glob('FTR-*')) if FEATURES.exists() else []
    sections = {k: [] for k in ['requirements', 'acceptance_criteria', 'plan_items', 'tasks', 'tests']}
    expected = {}
    for root in roots:
        counts, feature_sections = analyze(root)
        status = root/'status.yaml'
        expected[status] = status_text(read(status), counts)
        for key in sections:
            sections[key] += feature_sections[key]
    expected[TRACE] = trace_text(read(TRACE), sections)

    stale = [path for path, text in expected.items() if read(path) != text]
    if args.check:
        for path in stale:
            print(f'{path}: out of date. Run `make status` and commit the result.', file=sys.stderr)
        if stale:
            return 1
        print('status.yaml counts and traceability.yaml match the feature artifacts')
        return 0

    for path in stale:
        path.write_text(expected[path])
        print(f'Updated {path}')
    if not stale:
        print('status.yaml counts and traceability.yaml are already current')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
