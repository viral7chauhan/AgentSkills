#!/usr/bin/env python3
import argparse
import hashlib
import re
from pathlib import Path

REQUIRED_EVIDENCE = [
    'code_exists',
    'implementation_verified',
    'tests_exist',
    'tests_passed',
    'architecture_passed',
    'scope_passed',
    'ci_passed',
]
CLAIMED_STATES = {'CONVERGED', 'RELEASE_READY', 'RELEASED'}


def field(path: Path, name: str) -> str:
    if not path.exists():
        return ""
    for line in path.read_text().splitlines():
        if line.startswith(name + ":"):
            return line.split(":", 1)[1].strip().strip('"')
    return ""


def ids(path: Path, prefix: str):
    if not path.exists():
        return set()
    return set(re.findall(rf"\b{re.escape(prefix)}-[A-Za-z0-9-]+\b", path.read_text()))


def parse_plan_item_blocks(text: str):
    lines = text.splitlines()
    blocks = {}
    current = None
    buf = []
    for line in lines:
        m = re.match(r'^\s*-\s*id:\s*(P-[A-Za-z0-9-]+)\s*$', line)
        if m:
            if current:
                blocks[current] = '\n'.join(buf)
            current = m.group(1)
            buf = [line]
        elif current:
            buf.append(line)
    if current:
        blocks[current] = '\n'.join(buf)
    return blocks


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--feature')
    args = ap.parse_args()

    if args.feature:
        roots = list(Path('.sdd/features').glob(f'{args.feature}-*'))
    else:
        roots = sorted(Path('.sdd/features').glob('FTR-*')) if Path('.sdd/features').exists() else []

    if not roots:
        if args.feature:
            print(f'Feature not found: {args.feature}')
            return 2
        print('No feature folders found.')
        return 0

    failures = 0
    for root in roots:
        plan, execution, status = root/'plan.md', root/'execution.yaml', root/'status.yaml'
        tasks, tests = root/'tasks.md', root/'test-plan.md'
        missing = [str(p.relative_to(root)) for p in [plan, execution, status, tasks, tests] if not p.exists()]
        if missing:
            print(f'BLOCKED {root.name}: missing {", ".join(missing)}')
            failures += 1
            continue

        current_fp = hashlib.sha256(plan.read_bytes()).hexdigest()
        recorded_fp = field(execution, 'plan_fingerprint')
        selected = field(execution, 'selected_action')
        status_value = field(status, 'status')

        if current_fp != recorded_fp:
            print(f'BLOCKED {root.name}: plan changed without an explicit SDLC action')
            failures += 1
            continue

        plan_items = ids(plan, 'P')
        blocks = parse_plan_item_blocks(execution.read_text())
        missing_execution = sorted(plan_items - set(blocks))
        if missing_execution:
            print(f'BLOCKED {root.name}: plan items missing from execution.yaml: {", ".join(missing_execution)}')
            failures += 1
            continue

        claimed = status_value in CLAIMED_STATES
        feature_failed = False
        verified = 0
        for pid in sorted(plan_items):
            block = blocks[pid]
            item_status = re.search(r'^\s*status:\s*(\S+)', block, re.M)
            state = item_status.group(1) if item_status else 'MISSING'
            if state != 'VERIFIED':
                if claimed:
                    print(f'BLOCKED {root.name}: {pid} is {state}, but the feature is {status_value}; only VERIFIED can satisfy execution evidence')
                    feature_failed = True
                continue
            verified += 1
            for key in REQUIRED_EVIDENCE:
                m = re.search(rf'^\s*{re.escape(key)}:\s*(true|false|null)\s*$', block, re.M | re.I)
                value = m.group(1).lower() if m else 'missing'
                if value != 'true':
                    print(f'BLOCKED {root.name}: {pid} evidence {key}={value}; expected true')
                    feature_failed = True
        if feature_failed:
            failures += 1
            continue

        if status_value == 'CONVERGED' and selected == 'review':
            print(f'BLOCKED {root.name}: review-only plan change cannot be converged')
            failures += 1
            continue

        if claimed:
            print(f'PASS {root.name}: plan fingerprint and verified evidence are consistent for {len(plan_items)} plan item(s)')
        else:
            print(f'IN PROGRESS {root.name} ({status_value or "UNKNOWN"}): {verified} of {len(plan_items)} plan item(s) VERIFIED with full evidence; all are required at CONVERGED')

    if failures:
        print(f'\nExecution-check FAILED: {failures} feature(s) blocked.')
        return 1
    print('\nExecution-check PASSED')
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
